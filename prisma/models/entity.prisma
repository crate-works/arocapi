model Entity {
  id                String   @id

  name              String
  description       String

  entityType        String
  memberOf          String?
  rootCollection    String?
  metadataLicenseId String
  contentLicenseId  String

  meta              Json?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  file              File?

  @@index([memberOf])
  @@index([rootCollection])
  @@index([entityType])
  @@map("entity")
}
