{
  "type": "module",
  "name": "arocapi",
  "version": "4.0.1",
  "description": "An RO-Crate API",
  "main": "dist/app.js",
  "exports": {
    ".": "./dist/app.js"
  },
  "keywords": [
    "rocrate",
    "oni"
  ],
  "author": "John Ferlito <johnf@inodes.org>",
  "license": "ISC",
  "dependencies": {
    "@fastify/sensible": "^6.0.7",
    "@opensearch-project/opensearch": "^3.9.0",
    "@prisma/config": "^7.10.1",
    "content-disposition": "^3.0.0",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "concurrently": "^10.0.6",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "fastify-tsconfig": "^3.0.0",
    "knip": "^6.42.0",
    "lefthook": "^2.2.2",
    "prisma": "^7.10.1",
    "prisma-json-types-generator": "^5.2.0",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "vitest-mock-extended": "^5.1.1"
  },
  "peerDependencies": {
    "@prisma/client": ">=6"
  },
  "files": [
    "src",
    "!src/generated",
    "dist",
    "!dist/generated",
    "README.md",
    "prisma/models",
    "prisma.config.ts"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "dev": "pnpm run dev:clean && pnpm run build && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"pnpm:dev:start\" \"pnpm:watch\" ",
    "dev:start": "node --watch --env-file=.env dist/index.dev.js",
    "dev:clean": "rm -rf dist",
    "dbconsole": "docker compose exec db mysql --password=password catalog",
    "load-test-data": "tsx src/scripts/loadEntities.ts",
    "lint:biome": "biome check",
    "lint:types": "tsc --noEmit",
    "lint:examples": "tsc --emitDeclarationOnly && tsc -p website/examples",
    "lint:knip": "knip",
    "lint": "prisma generate >/dev/null && concurrently -p \"[{name}]\" -n \"biome,types,knip,examples\" -c \"yellow.bold,cyan.bold,magenta.bold,green.bold\" \"pnpm:lint:biome\" \"pnpm:lint:types\" \"pnpm:lint:knip\" \"pnpm:lint:examples\"",
    "test": "./scripts/setup-integration.sh vitest run",
    "test:ci": "vitest run",
    "test:watch": "./scripts/setup-integration.sh && vitest",
    "test:ui": "./scripts/setup-integration.sh && vitest --ui",
    "test:coverage": "./scripts/setup-integration.sh vitest run --coverage",
    "generate": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "seed": "rm -rf dist && pnpm run build && node --env-file=.env example/data/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/crate-works/arocapi"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "packageManager": "pnpm@12.11.2"
}
